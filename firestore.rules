rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /absensi/{idDokumen} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && idDokumen == request.auth.uid + "_" + request.resource.data.tanggal
        && request.resource.data.keys().hasAll([
          "nama", "kelas", "tanggal", "status", "uid", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "nama", "kelas", "tanggal", "status", "uid", "createdAt"
        ])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 80
        && request.resource.data.kelas is string
        && request.resource.data.kelas.size() > 0
        && request.resource.data.kelas.size() <= 30
        && request.resource.data.tanggal is string
        && request.resource.data.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status in ["Hadir", "Izin", "Sakit"]
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          "nama", "kelas", "tanggal", "status", "uid", "createdAt"
        ])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 80
        && request.resource.data.kelas is string
        && request.resource.data.kelas.size() > 0
        && request.resource.data.kelas.size() <= 30
        && request.resource.data.tanggal == resource.data.tanggal
        && request.resource.data.status in ["Hadir", "Izin", "Sakit"];

      allow delete: if false;
    }
  }
}
